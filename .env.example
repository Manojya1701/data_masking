# Server
PORT=3000
NODE_ENV=development

# Database (PostgreSQL)
# Local: postgresql://username:password@localhost:5432/udps_db
# Hosted: postgresql://username:password@host.render.com/udps_db?sslmode=require
DATABASE_URL=

# Upload limits (bytes)
MAX_FILE_SIZE=104857600

# Token expiry (ms) — how long download tokens are valid
TOKEN_EXPIRY_MS=600000

# Temp file cleanup interval (ms)
CLEANUP_INTERVAL_MS=300000

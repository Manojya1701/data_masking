{
  "name": "universal-data-protection-system",
  "version": "1.0.0",
  "description": "Unified interface to Mask, Hash, or Encrypt sensitive data across 13+ file formats",
  "main": "backend/server.js",
  "scripts": {
    "start": "node backend/server.js",
    "dev": "nodemon backend/server.js",
    "test": "jest --testPathPattern=tests/",

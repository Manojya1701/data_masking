  },
  "dependencies": {
    "@noble/hashes": "^1.4.0",
    "avsc": "^5.7.7",
    "cheerio": "^1.0.0",
    "cors": "^2.8.6",
    "csv-parse": "^5.5.6",
    "csv-stringify": "^6.4.6",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "fast-xml-parser": "^4.4.0",
    "js-yaml": "^4.1.0",
    "mime-types": "^2.1.35",
    "multer": "^2.2.0",
    "parquetjs-lite": "^0.8.7",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.0.0",
    "pg": "^8.23.0",
    "picojs": "^1.0.0",
    "sharp": "^0.33.4",
    "tesseract.js": "^5.0.0",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.4"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ]
  },
  "engines": {
    "node": ">=18.0.0"
  }
